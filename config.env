# ─────────────────────────────────────────────────────────────
#  Package settings for BatteryAlert
#  Read by ./package.sh — edit the values below, then run ./package.sh
#
#  A value can also be given for a single run, e.g.:
#     VERSION=1.2.0 BUILD_NUMBER=7 ./package.sh
#  (The behaviour of the app itself — thresholds, timings, sound — is in Sources/Config.swift.)
# ─────────────────────────────────────────────────────────────

# ── App identity ─────────────────────────────────────────────
APP_NAME="${APP_NAME:-BatteryAlert}"            # name of the .app (and the menu bar name)
EXECUTABLE_NAME="${EXECUTABLE_NAME:-BatteryAlert}"
BUNDLE_ID="${BUNDLE_ID:-nl.belastingdienst.BatteryAlert}"   # CHANGE to your own, e.g. nl.yourname.BatteryAlert

# ── Version ──────────────────────────────────────────────────
VERSION="${VERSION:-26.10.12}"                       # shown to the user (CFBundleShortVersionString)
BUILD_NUMBER="${BUILD_NUMBER:-1}"                 # increase for every build (CFBundleVersion)
COPYRIGHT="${COPYRIGHT:-Copyright © 2026 Edwin Pijper. Licensed under the GNU GPL v3.}"

# ── Build ────────────────────────────────────────────────────
MIN_MACOS="${MIN_MACOS:-12.0}"                    # minimum macOS version (12.0 is needed for the coloured icons)
ARCHS="${ARCHS:-arm64 x86_64}"                    # "arm64 x86_64" = universal, "arm64" = Apple Silicon only
SOURCE_DIR="${SOURCE_DIR:-Sources}"
ICON_FILE="${ICON_FILE-Resources/AppIcon.icns}"   # app icon (default: red, almost empty battery). Set ICON_FILE="" for no icon.
                                                  # Regenerate/modify it with: python3 Resources/make_icon.py

# ── Output ───────────────────────────────────────────────────
BUILD_DIR="${BUILD_DIR:-build}"                   # temporary files + the finished .app
DIST_DIR="${DIST_DIR:-dist}"                      # finished packages end up here
PACKAGE_FORMATS="${PACKAGE_FORMATS:-dmg zip}"     # any of: dmg zip pkg
PACKAGE_NAME="${PACKAGE_NAME:-${APP_NAME}-${VERSION}}"   # file name without extension
DMG_VOLUME_NAME="${DMG_VOLUME_NAME:-${APP_NAME} ${VERSION}}"

# ── Checks ───────────────────────────────────────────────────
SMOKE_TEST="${SMOKE_TEST:-1}"                     # 1 = start the built app for 3 seconds and check that it keeps running

# ── Signing (optional) ───────────────────────────────────────
# "-" = ad-hoc signature (works on your own Mac, other Macs show a Gatekeeper warning).
# For distribution use your certificate, e.g. "Developer ID Application: Edwin Pijper (TEAMID)"
SIGN_IDENTITY="${SIGN_IDENTITY:--}"
# Only for the .pkg format, e.g. "Developer ID Installer: Edwin Pijper (TEAMID)". Empty = unsigned pkg.
PKG_SIGN_IDENTITY="${PKG_SIGN_IDENTITY:-}"

# ── Notarization (optional, needs a paid Apple Developer account) ──
# Name of a keychain profile created with:
#   xcrun notarytool store-credentials "my-profile" --apple-id ... --team-id ... --password ...
# Empty = skip notarization.
NOTARY_PROFILE="${NOTARY_PROFILE:-}"
